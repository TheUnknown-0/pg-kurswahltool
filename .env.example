# Kopiere diese Datei nach .env und setze sichere Passwörter.
DB_ROOT_PASS=bitte_sicheres_root_passwort_setzen
DB_USER=kurswahl
DB_PASS=bitte_sicheres_passwort_setzen
DB_NAME=kurswahl
APP_PORT=9020
APP_ENV=production

# Admin-Konto, das beim ersten Start angelegt wird (Passwort mind. 10 Zeichen).
# Später ändern: Passwort hier anpassen und
#   docker compose exec app php bin/create-admin.php --reset
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Verzeichnis, in dem die Anwendung liegt. "/" = eigene (Sub-)Domain.
BASE_URL=/

# Import-Ordner auf dem Host: hier abgelegte PDFs/ZIPs liest der Worker automatisch ein.
IMPORT_PATH=./import
# Sekunden zwischen zwei Durchläufen des Import-Workers
IMPORT_INTERVAL=15

# Hinter einem HTTPS-Reverse-Proxy: 1 erzwingt das Secure-Flag der Cookies.
SECURE_COOKIES=

PMA_PORT=8091
DB_WAIT_TIMEOUT=120

# Adressen, denen der X-Forwarded-For-Header geglaubt wird — nur die des eigenen
# Reverse-Proxys, kommagetrennt. LEER LASSEN, wenn die Anwendung direkt erreichbar ist.
TRUSTED_PROXIES=
